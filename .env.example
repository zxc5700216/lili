# Box local (current sandbox Postgres):
DATABASE_URL=postgresql://studylab:studylab@127.0.0.1:5432/studylab
# Alternate / docker-compose style:
# DATABASE_URL=postgresql://duobaoyu:duobaoyu@localhost:54329/duobaoyu

# 工具密钥不要写进这个文件。首次在「工具配置」保存时，会在 .env.local 生成 TOOL_CONFIG_KEY，密文在 .secrets/（均已 gitignore）。

# Production reverse-proxy prefix is set in next.config.ts (basePath: /studylab).
# Optional override for MCP/public URL helpers:
# NEXT_PUBLIC_BASE_PATH=/studylab
